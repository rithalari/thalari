<script>
(function () {
  var root = document.getElementById('vb-w8m');
  if (!root) return;

  var cards = root.querySelectorAll('.vb-w8m__card');

  Array.prototype.forEach.call(cards, function (card) {
    var toggle = card.querySelector('.vb-w8m__btn--ghost');
    var details = card.querySelector('.vb-w8m__details');
    if (!toggle || !details) return;
    toggle.addEventListener('click', function () {
      var open = details.hasAttribute('hidden');
      if (open) { details.removeAttribute('hidden'); } else { details.setAttribute('hidden', ''); }
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  /* ---------- lightbox ---------- */
  var lb = root.querySelector('#vb-w8m-lb');
  var lbImg = root.querySelector('#vb-w8m-lb-img');
  var lbTitle = root.querySelector('#vb-w8m-lb-title');
  var lbCount = root.querySelector('#vb-w8m-lb-count');
  var closeBtn = root.querySelector('#vb-w8m-lb-close');
  var prevBtn = root.querySelector('#vb-w8m-lb-prev');
  var nextBtn = root.querySelector('#vb-w8m-lb-next');
  var shots = root.querySelectorAll('.vb-w8m__frame[data-full]');
  var index = 0;
  var opener = null;

  function pad(n) { return String(n).padStart(2, '0'); }

  function render() {
    var shot = shots[index];
    if (!shot || !lbImg) return;
    lbImg.setAttribute('src', shot.getAttribute('data-full'));
    lbImg.setAttribute('alt', shot.getAttribute('data-title') || '');
    if (lbTitle) lbTitle.textContent = shot.getAttribute('data-title') || '';
    if (lbCount) lbCount.textContent = '(' + pad(index + 1) + ' / ' + pad(shots.length) + ')';
  }

  function open(i, trigger) {
    if (!lb || !shots.length) return;
    index = (i + shots.length) % shots.length;
    opener = trigger || null;
    lb.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    render();
    if (closeBtn) closeBtn.focus();
  }

  function close() {
    if (!lb) return;
    lb.setAttribute('hidden', '');
    document.body.style.overflow = '';
    if (opener && opener.focus) opener.focus();
    opener = null;
  }

  Array.prototype.forEach.call(shots, function (shot, i) {
    shot.addEventListener('click', function () { open(i, shot); });
  });

  if (closeBtn) closeBtn.addEventListener('click', close);
  if (prevBtn) prevBtn.addEventListener('click', function () { open(index - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { open(index + 1); });

  Array.prototype.forEach.call(lb ? lb.querySelectorAll('[data-lb-close]') : [], function (el) {
    el.addEventListener('click', close);
  });

  document.addEventListener('keydown', function (event) {
    if (!lb || lb.hasAttribute('hidden')) return;
    if (event.key === 'Escape') { event.preventDefault(); close(); }
    else if (event.key === 'ArrowLeft') { event.preventDefault(); open(index - 1); }
    else if (event.key === 'ArrowRight') { event.preventDefault(); open(index + 1); }
  });

  if (!('IntersectionObserver' in window)) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) return;

  root.classList.add('is-anim');
  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('is-in');
      observer.unobserve(entry.target);
    });
  }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });

  Array.prototype.forEach.call(cards, function (card, i) {
    card.style.transitionDelay = (i % 4) * 0.07 + 's';
    observer.observe(card);
  });
})();
</script>
