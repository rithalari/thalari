<script>
(function () {
  var root = document.getElementById('vb-i3n');
  if (!root) return;
  var track = root.querySelector('#vb-i3n-track');
  var prev = root.querySelector('#vb-i3n-prev');
  var next = root.querySelector('#vb-i3n-next');
  var counter = root.querySelector('#vb-i3n-counter');
  if (!track) return;

  var cells = track.querySelectorAll('.vb-i3n__cell');
  var total = cells.length;

  function pad(n) { return String(n).padStart(2, '0'); }

  function updateCounter() {
    if (!counter || !total) return;
    var box = track.getBoundingClientRect();
    var index = 0;
    var best = Infinity;
    Array.prototype.forEach.call(cells, function (cell, i) {
      var delta = Math.abs(cell.getBoundingClientRect().top - box.top);
      if (delta < best) { best = delta; index = i; }
    });
    counter.textContent = '(' + pad(index + 1) + ' / ' + pad(total) + ')';
  }

  function step(dir) {
    var amount = Math.max(track.clientHeight * 0.7, 240);
    track.scrollBy({ top: dir * amount, behavior: 'smooth' });
  }

  if (prev) prev.addEventListener('click', function () { step(-1); });
  if (next) next.addEventListener('click', function () { step(1); });

  var raf = null;
  track.addEventListener('scroll', function () {
    if (raf) return;
    raf = window.requestAnimationFrame(function () { raf = null; updateCounter(); });
  }, { passive: true });

  updateCounter();
  window.addEventListener('resize', updateCounter);

  /* ---------- lightbox ---------- */
  var lb = root.querySelector('#vb-i3n-lb');
  var lbImg = root.querySelector('#vb-i3n-lb-img');
  var lbTitle = root.querySelector('#vb-i3n-lb-title');
  var lbCount = root.querySelector('#vb-i3n-lb-count');
  var closeBtn = root.querySelector('#vb-i3n-lb-close');
  var prevBtn = root.querySelector('#vb-i3n-lb-prev');
  var nextBtn = root.querySelector('#vb-i3n-lb-next');
  var shots = track.querySelectorAll('.vb-i3n__cell[data-full]');
  var index = 0;
  var opener = null;

  function render() {
    var shot = shots[index];
    if (!shot || !lbImg) return;
    lbImg.setAttribute('src', shot.getAttribute('data-full'));
    lbImg.setAttribute('alt', shot.getAttribute('data-title') || '');
    if (lbTitle) lbTitle.textContent = shot.getAttribute('data-title') || '';
    if (lbCount) lbCount.textContent = '(' + pad(index + 1) + ' / ' + pad(shots.length) + ')';
  }

  function open(i, trigger) {
    if (!lb || !shots.length) return;
    index = (i + shots.length) % shots.length;
    opener = trigger || null;
    lb.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    render();
    if (closeBtn) closeBtn.focus();
  }

  function close() {
    if (!lb) return;
    lb.setAttribute('hidden', '');
    document.body.style.overflow = '';
    if (opener && opener.focus) opener.focus();
    opener = null;
  }

  Array.prototype.forEach.call(shots, function (shot, i) {
    shot.addEventListener('click', function () { open(i, shot); });
  });

  if (closeBtn) closeBtn.addEventListener('click', close);
  if (prevBtn) prevBtn.addEventListener('click', function () { open(index - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { open(index + 1); });

  Array.prototype.forEach.call(lb ? lb.querySelectorAll('[data-lb-close]') : [], function (el) {
    el.addEventListener('click', close);
  });

  document.addEventListener('keydown', function (event) {
    if (!lb || lb.hasAttribute('hidden')) return;
    if (event.key === 'Escape') { event.preventDefault(); close(); }
    else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') { event.preventDefault(); open(index - 1); }
    else if (event.key === 'ArrowDown' || event.key === 'ArrowRight') { event.preventDefault(); open(index + 1); }
  });
})();
</script>
