<script>
(function () {
  var root = document.getElementById('vb-c9r');
  if (!root) return;

  var topBtn = root.querySelector('#vb-c9r-top');
  if (topBtn) {
    topBtn.addEventListener('click', function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }

  var form = root.querySelector('#vb-c9r-form');
  if (!form) return;
  var submitButton = form.querySelector('[type="submit"]');

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    if (typeof window.t_forms__initBtnClick !== 'function') {
      if (typeof window.tildaForm === 'undefined' || typeof window.tildaForm.validate !== 'function') {
        var box = form.querySelector('.js-successbox');
        if (box) {
          box.style.display = 'block';
          box.textContent = 'Спасибо! Мы свяжемся с вами в течение 24 часов.';
        }
        return;
      }
      window.tildaForm.hideErrors(form);
      var errors = window.tildaForm.validate(form);
      var hasErrors = window.tildaForm.showErrors(form, errors);
      if (hasErrors) return;
      window.tildaForm.successEnd(form, null, null);
      return;
    }
    window.t_forms__initBtnClick({
      target: submitButton,
      srcElement: submitButton,
      preventDefault: function () {}
    });
  });
})();
</script>
